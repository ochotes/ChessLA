# Copy this file to .env and fill in real values. Never commit .env.
# All secrets live here, on the server, and are never sent to the browser.

# SQLite file for local dev. Point this at a postgresql:// URL in production.
DATABASE_URL="file:./dev.db"

NODE_ENV=development
PORT=4000

# Generate strong random secrets, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret

# The exact origin(s) the client is served from, comma separated. Used for CORS
# and cookie settings. In production this must be your real https:// domain.
CLIENT_ORIGIN=http://localhost:5173

# Set to "true" once you are running behind HTTPS (a real domain + TLS
# certificate, usually terminated at your hosting provider or reverse proxy).
# When true, cookies are marked Secure and the server redirects http -> https.
FORCE_HTTPS=false

# Optional: outbound email for password resets. If unset, reset links are
# logged to the server console instead of emailed (useful for local dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="ChessLA <no-reply@chessla.com>"

# Optional: server-side spam protection for auth/contact forms (Cloudflare
# Turnstile). Leave blank to disable verification in local dev.
TURNSTILE_SECRET_KEY=
