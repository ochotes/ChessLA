# Copy to .env.local. Only ever put PUBLIC, non-secret values here — Vite
# inlines every VITE_-prefixed variable straight into the shipped JS bundle,
# so nothing that must stay confidential (API keys, DB credentials, JWT
# secrets) belongs on this side. Those all live in server/.env instead.

# Leave blank to keep analytics fully disabled (the app still works, no
# tracking script is ever loaded). Fill in only after you have a real
# account, and only what the cookie consent banner allows will actually fire.
VITE_ANALYTICS_PROVIDER=
VITE_ANALYTICS_ID=

# Public site key for Cloudflare Turnstile (spam protection on auth forms).
# Public by design — the matching secret key lives server-side only.
VITE_TURNSTILE_SITE_KEY=
